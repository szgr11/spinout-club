{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "raspy-water-4eb5",
  "account_id": "260a0ada5fbdf9925db5e9d497b70ddc",
  "compatibility_date": "2026-05-13",
  "preview_urls": false,
  "vars": {
    "SUPABASE_URL": "https://wzdqnzfoaaxmnkvxtlpt.supabase.co",
    "SUPABASE_PUBLISHABLE_KEY": "sb_publishable_ui_1-O-OD_r4G-Ef003YCg_qYHymDOM"
  },
  "main": "worker/index.js",
  "kv_namespaces": [
    {
      "binding": "EVENTS",
      "id": "df8826bff2b941ab86dffca41465158e"
    }
  ],
  "observability": {
    "enabled": true,
    "redact_query_string": true,
    "logs": {"enabled": true, "invocation_logs": false}
  },
  "triggers": {
    "crons": [
      "0 * * * *"
    ]
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ],
    "not_found_handling": "single-page-application"
  },
  "previews": {
    "kv_namespaces": [
      {
        "binding": "EVENTS",
        "id": "03e3d51c87d74aa698e05187cd7fc587"
      }
    ]
  }
}
